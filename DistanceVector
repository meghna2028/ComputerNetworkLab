
#include <iostream>
#include <vector>
#include <iomanip>
using namespace std;

const int INF = 9999;

int main() {
    int n;
    cout << "Enter number of routers: ";
    cin >> n;

    vector<vector<int>> cost(n, vector<int>(n));
    vector<vector<int>> dist(n, vector<int>(n));
    vector<vector<int>> nextHop(n, vector<int>(n, -1));

    cout << "Enter cost matrix (9999 for no link):\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];

            if (i == j) {
                cost[i][j] = 0;
            } else if (cost[i][j] == 0) {
                cost[i][j] = INF;
            }

            dist[i][j] = cost[i][j];

            if (i != j && cost[i][j] < INF)
                nextHop[i][j] = j;
        }
    }

    cout << "\nInitial Distance Matrix:\n";
    for (const auto &row : dist) {
        for (int x : row) {
            if (x >= INF)
                cout << setw(6) << "INF";
            else
                cout << setw(6) << x;
        }
        cout << '\n';
    }

    bool changed;
    do {
        changed = false;
        vector<vector<int>> updated = dist;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                for (int k = 0; k < n; k++) {
                    if (i == k || cost[i][k] >= INF ||
                        dist[k][j] >= INF)
                        continue;

                    int newCost = cost[i][k] + dist[k][j];

                    if (newCost < updated[i][j]) {
                        updated[i][j] = newCost;
                        nextHop[i][j] = k;
                        changed = true;
                    }
                }
            }
        }

        dist = updated;
    } while (changed);

    cout << "\nFinal Routing Tables:\n";

    for (int i = 0; i < n; i++) {
        cout << "\nRouter " << char('A' + i) << '\n';
        cout << "Destination\tCost\tNext Hop\n";

        for (int j = 0; j < n; j++) {
            cout << char('A' + j) << "\t\t";

            if (dist[i][j] >= INF) {
                cout << "INF\t-\n";
            } else {
                cout << dist[i][j] << "\t";

                if (i == j)
                    cout << "-\n";
                else
                    cout << char('A' + nextHop[i][j]) << '\n';
            }
        }
    }

    int src, dest;
    cout << "\nEnter source and destination indices (0 to "
         << n - 1 << "): ";
    cin >> src >> dest;

    if (src < 0 || src >= n || dest < 0 || dest >= n) {
        cout << "Invalid router index.\n";
        return 0;
    }

    if (dist[src][dest] >= INF) {
        cout << "No path exists between the selected routers.\n";
        return 0;
    }

    cout << "Shortest path: " << char('A' + src);
    int current = src;

    for (int count = 0; current != dest && count < n; count++) {
        current = nextHop[current][dest];

        if (current < 0) {
            cout << "\nPath unavailable.\n";
            return 0;
        }

        cout << " -> " << char('A' + current);
    }

    cout << "\nMinimum cost: " << dist[src][dest] << '\n';

    return 0;
}
