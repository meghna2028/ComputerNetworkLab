
#include <iostream>
#include <cstring>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
using namespace std;

int main() {
    int server_fd;
    char buffer[1024];

    // Create UDP socket
    server_fd = socket(AF_INET, SOCK_DGRAM, 0);

    // Configure server address
    sockaddr_in server_addr{};
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(8080);

    // Bind socket
    bind(server_fd, (struct sockaddr*)&server_addr,
         sizeof(server_addr));

    cout << "UDP Server is waiting for messages..." << endl;

    // Receive message from client
    sockaddr_in client_addr{};
    socklen_t client_len = sizeof(client_addr);

    memset(buffer, 0, sizeof(buffer));
    int n = recvfrom(server_fd, buffer, sizeof(buffer) - 1, 0,
                     (struct sockaddr*)&client_addr, &client_len);

    if (n >= 0) {
        buffer[n] = '\0';
        cout << "Message from client: " << buffer << endl;

        // Send reply to client
        const char* reply = "Message received successfully!";
        sendto(server_fd, reply, strlen(reply), 0,
               (struct sockaddr*)&client_addr, client_len);
    }

    // Close socket
    close(server_fd);

    return 0;
}
